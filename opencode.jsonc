{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "model": "opencode/grok-code",
  "small_model": "opencode/grok-code",
  "tools": {
    "todowrite": true,
    "todoread": true,
    "webfetch": true
  },
  "permission": {
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "mcp": {
    "mcp_playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "mcp_DOCKER": {
      "enabled": true,
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ]
    },
    "mcp_context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "mcp_gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  }
}