App(
    appid="hid_bt_bridge",
    name="BT Remote Bridge",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="hid_bt_bridge_app",
    stack_size=2 * 1024,
    sources=["*.c", "!transport_usb.c"],
    cdefines=["HID_TRANSPORT_BT"],
    fap_libs=["bt_profile"],
    fap_description="Bluetooth Remote with USB Bridge",
    fap_version="1.2",
    fap_category="Bluetooth",
    fap_icon="hid_bt_10px.png",
    fap_icon_assets_symbol="hid",
)
